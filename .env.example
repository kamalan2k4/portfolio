# Canonical site origin, no trailing slash. Used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://kamalan-cs.vercel.app

# Contact form (server-only). Without these, the form falls back to a prefilled mailto link.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
# Where messages are delivered. Defaults to the email in src/content/profile.ts.
CONTACT_TO_EMAIL=
